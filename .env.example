# Deployment bootstrap/infra only. All operational settings (branding, email/SMTP,
# reminders, scoring weights, file limits, users) are managed in-app via Settings.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://mitch:mitch@localhost:5432/mitch_risk?schema=public"

# Auth.js (NextAuth v5) session/JWT signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-with-a-long-random-secret"

# Used to encrypt secret settings (e.g. SMTP password) at rest. Must be >= 32 chars.
APP_ENCRYPTION_KEY="change-me-32-byte-minimum-encryption-key"

# Public base URL of the app (used for portal links and email links).
APP_URL="http://localhost:3000"

# Shared secret for the cron endpoint (Phase 6). Optional until then.
# CRON_SECRET="change-me-cron-secret"

# Local-disk evidence storage root (Phase 3).
EVIDENCE_STORAGE_PATH="./.storage/evidence"

# SSO is configured entirely in‑app (Settings → SSO tab). Client credentials
# (Entra ID, Google, and custom OIDC) are stored encrypted in the database,
# not in environment variables.
