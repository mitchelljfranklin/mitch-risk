# Deployment bootstrap/infra only. All operational settings (branding, email/SMTP,
# reminders, scoring weights, file limits, users) are managed in-app via Settings.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://mitch:mitch@localhost:5432/mitch_risk?schema=public"

# Dedicated database for the integration test suite. Integration tests DELETE and
# reset data (settings, notification logs, etc.), so they must NOT run against your
# dev/prod database. When set, `npm run test` uses this instead of DATABASE_URL.
# The test runner refuses to run unless the target DB name contains "test" (or you
# set ALLOW_TESTS_ON_THIS_DB=1). Create + migrate it once — see README → Testing.
# TEST_DATABASE_URL="postgresql://mitch:mitch@localhost:5432/mitch_risk_test?schema=public"

# Auth.js (NextAuth v5) session/JWT signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-with-a-long-random-secret"

# Used to encrypt secret settings (e.g. SMTP password) at rest. Must be >= 32 chars.
APP_ENCRYPTION_KEY="change-me-32-byte-minimum-encryption-key"

# Public base URL of the app (used for portal/email links AND, by default, for
# Auth.js OAuth callback URLs). Set this to your public HTTPS origin behind a
# reverse proxy, e.g. https://risk.example.com
APP_URL="http://localhost:3000"

# Shared secret for the secured cron endpoint (/api/cron/run). REQUIRED in
# production (NODE_ENV=production) — the app refuses to start without it. When
# unset in development the cron endpoint stays locked (always returns 401).
# CRON_SECRET="change-me-cron-secret"

# Local-disk evidence storage root (Phase 3).
EVIDENCE_STORAGE_PATH="./.storage/evidence"

# Reverse-proxy client-IP trust. Set to the number of trusted reverse proxies in
# front of the app (Caddy/nginx/Zoraxy/Azure = 1; a CDN in front of a proxy = 2).
# The client IP (used for rate limiting and API-key IP allowlists) is taken this
# many hops from the right of X-Forwarded-For, so a client cannot spoof it.
# Default: 0 — X-Forwarded-For is IGNORED so a client cannot spoof its IP. You
# MUST set this to match your topology (e.g. 1 behind a single proxy); leaving it
# at 0 behind a proxy makes every request look like it comes from the proxy, and
# setting it higher than your real proxy count lets clients spoof allowlisted IPs.
TRUSTED_PROXY_COUNT="1"

# Optional: if your proxy/CDN sets a dedicated single client-IP header, use it
# instead of X-Forwarded-For (e.g. cf-connecting-ip, x-azure-clientip, x-real-ip).
# CLIENT_IP_HEADER="cf-connecting-ip"

# Optional: public origin used by Auth.js for OAuth/OIDC callback URLs. If unset,
# it defaults to APP_URL, so normally you only need to set APP_URL. Set AUTH_URL
# explicitly only when auth must use a different origin than APP_URL.
# AUTH_URL="https://risk.example.com"

# Opt out of Next.js anonymous telemetry. Set to "1" to disable.
# NEXT_TELEMETRY_DISABLED="1"

# SSO is configured entirely in‑app (Settings → SSO tab). Client credentials
# (Entra ID, Google, and custom OIDC) are stored encrypted in the database,
# not in environment variables.
