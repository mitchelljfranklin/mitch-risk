    "marked": "^18.2.0",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.15.1",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.6.0",
    "pg": "^8.13.0",
    "prisma": "^7.10.1",
    "radix-ui": "^1.6.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "^6.11.16",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.2",
    "sanitize-html": "^2.18.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
